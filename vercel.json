{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "cd web && npm install --no-audit --no-fund && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/*.js": {
      "includeFiles": "orders.json"
    }
  }
}
